# Server
PORT=3001

# Database (local: docker compose up -d; Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://pyground:pyground@localhost:5434/pyground
# Only for running migrations against Railway from your machine
# DATABASE_PUBLIC_URL=
# Optional: pg pool size (default 5)
# DATABASE_POOL_MAX=5

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Seed (bun run db:seed)
SEED_ADMIN_EMAIL=admin@pyground.local
SEED_ADMIN_PASSWORD=change-me-please
