# Server
PORT=3001
# X-Forwarded-For entries to trust from the right (1 = Railway edge; 2 = web proxy + Railway edge)
TRUSTED_PROXY_HOPS=1

# Database (local: docker compose up -d; Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://pyground:pyground@localhost:5434/pyground
# Only for running migrations against Railway from your machine
# DATABASE_PUBLIC_URL=
# Optional: pg pool size (default 5)
# DATABASE_POOL_MAX=5

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public origin of pyground-web (it proxies /api/* here). Used for auth links, cookies, trusted origins.
WEB_URL=http://localhost:3000
# Optional: share auth cookies across subdomains on a custom domain, e.g. .pyground.id
# COOKIE_DOMAIN=

# Seed (bun run db:seed)
SEED_ADMIN_EMAIL=admin@pyground.local
SEED_ADMIN_PASSWORD=change-me-please

# Midtrans Snap. Sandbox keys: dashboard.sandbox.midtrans.com > Settings > Access Keys.
# Server key stays on the API only; the client key is public (pyground-web loads snap.js with it).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Price of the 30-day access pass in Rupiah (integer)
ACCESS_PASS_PRICE_IDR=49000
# Marketer codes, the same for every marketer (whole percentages). Discount for a first-time buyer who enters
# a valid code (0-90), and the marketer's commission on what the buyer paid (0-100).
MARKETING_DISCOUNT_PERCENT=10
MARKETING_COMMISSION_PERCENT=20

# Resend. Without RESEND_API_KEY, emails are printed to the console in development (never in production).
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Pyground <noreply@pyground.id>"
EMAIL_FROM=

# Daily backup cron (bun run cron:backup): pg_dump -> S3-compatible bucket (R2, S3, B2, ...)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# "auto" works for R2; use the bucket's region for AWS S3
BACKUP_S3_REGION=auto
# Optional: path to a pg_dump matching the server's major version (default: pg_dump on PATH)
# PG_DUMP_PATH=
