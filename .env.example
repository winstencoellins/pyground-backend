# Server
PORT=3001
# X-Forwarded-For entries to trust from the right (1 = Railway edge; 2 = web proxy + Railway edge)
TRUSTED_PROXY_HOPS=1

# Database (local: docker compose up -d; Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://pyground:pyground@localhost:5434/pyground
# Only for running migrations against Railway from your machine
# DATABASE_PUBLIC_URL=
# Optional: pg pool size (default 5)
# DATABASE_POOL_MAX=5

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public origin of pyground-web (it proxies /api/* here). Used for auth links, cookies, trusted origins.
WEB_URL=http://localhost:3000
# Optional: share auth cookies across subdomains on a custom domain, e.g. .pyground.id
# COOKIE_DOMAIN=

# Seed (bun run db:seed)
SEED_ADMIN_EMAIL=admin@pyground.local
SEED_ADMIN_PASSWORD=change-me-please
