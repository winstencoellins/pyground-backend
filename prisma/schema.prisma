generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Locale {
  ID
  EN
}

enum ReminderKind {
  EXPIRES_IN_3_DAYS
  EXPIRES_TODAY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// ---------- Better Auth (generated by `bunx auth generate`, then extended) ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          Role      @default(STUDENT)
  accessUntil   DateTime? @map("access_until")
  locale        Locale    @default(ID)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  orders         Order[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  accessGrants   AccessGrant[]    @relation("GrantRecipient")
  grantsGiven    AccessGrant[]    @relation("GrantAdmin")
  reminderEmails ReminderEmail[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------- Pyground ----------

model Order {
  id                    String      @id @default(cuid())
  userId                String      @map("user_id")
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId               String      @unique @map("order_id") // sent to Midtrans as order_id
  amount                Int // Rupiah
  status                OrderStatus @default(PENDING)
  paymentType           String?     @map("payment_type")
  midtransTransactionId String?     @map("midtrans_transaction_id")
  snapToken             String?     @map("snap_token") // to resume an unfinished payment
  snapRedirectUrl       String?     @map("snap_redirect_url")
  rawNotification       Json?       @map("raw_notification")
  createdAt             DateTime    @default(now()) @map("created_at")
  paidAt                DateTime?   @map("paid_at")

  @@index([userId])
  @@map("orders")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String   @map("lesson_slug")
  completedAt DateTime @default(now()) @map("completed_at")

  // Also serves as the userId index (leading column).
  @@unique([userId, lessonSlug])
  @@map("lesson_progress")
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug String   @map("lesson_slug")
  score      Int
  answers    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, lessonSlug])
  @@map("quiz_attempts")
}

model AccessGrant {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: an admin who granted access can't be deleted silently, so the audit trail survives.
  grantedById String   @map("granted_by_id")
  grantedBy   User     @relation("GrantAdmin", fields: [grantedById], references: [id], onDelete: Restrict)
  days        Int // positive = grant, negative = revoke
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([grantedById])
  @@map("access_grants")
}

/// One row per reminder actually sent, so re-running the cron never sends twice.
/// accessUntil is the expiry the email was about: renewing changes it and re-arms the reminders.
model ReminderEmail {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ReminderKind
  accessUntil DateTime     @map("access_until")
  sentAt      DateTime     @default(now()) @map("sent_at")

  // Also serves as the userId index (leading column).
  @@unique([userId, kind, accessUntil])
  @@map("reminder_emails")
}
